; NPT equilibration, 200 ps, position restraints on
define                 = -DPOSRES
integrator             = md
dt                     = 0.002
nsteps                 = 100000
nstxout-compressed     = 5000
nstenergy              = 500
nstlog                 = 5000
continuation           = yes
gen_vel                = no
tcoupl                 = V-rescale
tc-grps                = Protein Non-Protein
tau_t                  = 0.1 0.1
ref_t                  = 300 300
pcoupl                 = C-rescale
pcoupltype             = isotropic
tau_p                  = 2.0
ref_p                  = 1.0
compressibility        = 4.5e-5
refcoord_scaling       = com
; --- shared by all stages ---
constraints            = h-bonds
constraint-algorithm   = lincs
cutoff-scheme          = Verlet
nstlist                = 20
coulombtype            = PME
rcoulomb               = 1.2
vdwtype                = cutoff
vdw-modifier           = force-switch
rvdw-switch            = 1.0
rvdw                   = 1.2
DispCorr               = no
pbc                    = xyz
